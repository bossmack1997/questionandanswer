rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if student is accessing their own data
    function isOwner(studentId) {
      return request.auth != null && (request.auth.uid == studentId || request.auth.token.name == studentId);
    }

    // 1. Task Submissions: Strictly ONE-TIME WRITE. Once created, cannot be modified or deleted.
    match /submissions/{submissionId} {
      allow read: if true;
      // Allow create only if document does not exist yet (immutable record)
      allow create: if request.resource.data.studentId != null 
                    && request.resource.data.taskId != null
                    && request.resource.data.score != null;
      // Disallow updating or deleting submitted assessments
      allow update, delete: if false;
    }

    // 2. Quiz Results (Teacher & Student records): Immutable after creation
    match /quiz_results/{resultId} {
      allow read: if true;
      allow create: if request.resource.data.studentName != null;
      allow update, delete: if false;
    }

    // 3. Active in-progress attempts (temporary autosync state)
    match /active_attempts/{attemptId} {
      allow read, write, delete: if true;
    }

    // 4. Student Profiles & Registrations
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Default rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
