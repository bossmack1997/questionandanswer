rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if teacher is authenticated
    function isTeacher() {
      return request.auth != null;
    }

    // 1. Task Submissions: Strictly ONE-TIME WRITE. Once created, cannot be modified or deleted.
    // Stored as: submissions/{studentId}_task{taskId}
    match /submissions/{submissionId} {
      allow read: if true;
      // Allow create only (immutable one-time write)
      allow create: if request.resource.data.studentId != null 
                    && request.resource.data.taskId != null
                    && request.resource.data.score != null;
      // Disallow updating or deleting submitted assessments by students; allow teacher management if needed
      allow update, delete: if isTeacher();
    }

    // 2. Quiz Results (Teacher & Student records): Immutable after creation
    match /quiz_results/{resultId} {
      allow read: if true;
      allow create: if request.resource.data.studentName != null;
      allow update, delete: if isTeacher();
    }

    // 3. Active in-progress attempts (temporary autosync state during active quiz)
    match /active_attempts/{attemptId} {
      allow read, write, delete: if true;
    }

    // 4. Student Profiles & Registrations
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Default deny for unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

